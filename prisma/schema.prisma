generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum PackageType {
  READY
  UPCOMING
}

enum FlightStops {
  DIRECT
  ONE_STOP
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
}

enum BookingItemType {
  FLIGHT
  PACKAGE
  HOTEL
  CUSTOM
}

enum QueryStatus {
  NEW
  REPLIED
  CLOSED
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  mobile       String
  email        String    @unique
  passwordHash String
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  bookings     Booking[]
}

model Package {
  id        Int         @id @default(autoincrement())
  type      PackageType
  name      String
  badge     String?
  days      String
  persons   String
  place     String
  rating    Float       @default(5.0)
  reviews   Int         @default(0)
  price     Int
  imageUrl  String
  startDate String?
  active    Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Flight {
  id         Int         @id @default(autoincrement())
  airline    String
  fromCity   String
  toCity     String
  departTime String
  arriveTime String
  duration   String
  stops      FlightStops
  price      Int
  date       String
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Hotel {
  id            Int      @id @default(autoincrement())
  name          String
  city          String
  stars         Int
  pricePerNight Int
  imageUrl      String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Destination {
  id        Int      @id @default(autoincrement())
  name      String
  country   String
  price     Int
  imageUrl  String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id             Int             @id @default(autoincrement())
  bookingCode    String          @unique
  userId         Int?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName   String
  customerMobile String
  customerEmail  String
  passportNo     String?
  itemTitle      String
  itemType       BookingItemType @default(PACKAGE)
  packageId      Int?
  flightId       Int?
  travelDate     String
  note           String?
  totalAmount    Int
  status         BookingStatus   @default(REQUESTED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  invoice        Invoice?
}

model Invoice {
  id              Int           @id @default(autoincrement())
  invoiceNo       String        @unique
  bookingId       Int           @unique
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerName    String
  customerEmail   String
  customerMobile  String
  itemDescription String
  totalAmount     Int
  status          BookingStatus @default(REQUESTED)
  issuedAt        DateTime      @default(now())
}

model Query {
  id         Int         @id @default(autoincrement())
  queryCode  String      @unique
  name       String
  mobile     String
  email      String
  type       String
  service    String?
  message    String
  status     QueryStatus @default(NEW)
  adminReply String?
  repliedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model SiteSetting {
  id              Int      @id @default(1)
  officeAddress   String
  phoneHotline    String
  supportEmail    String
  bookingPhone    String
  whatsappNumber  String
  privacyPolicy   String
  termsConditions String
  refundPolicy    String
  updatedAt       DateTime @updatedAt
}
