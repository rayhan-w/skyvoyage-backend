generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum PackageType {
  READY
  UPCOMING
}

enum FlightStops {
  DIRECT
  ONE_STOP
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  mobile       String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
}

model Package {
  id        Int         @id @default(autoincrement())
  type      PackageType
  name      String
  badge     String?
  days      String
  persons   String
  place     String
  rating    Float       @default(5.0)
  reviews   Int         @default(0)
  price     Int
  imageUrl  String
  startDate String?
  active    Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Flight {
  id         Int         @id @default(autoincrement())
  airline    String
  fromCity   String
  toCity     String
  departTime String
  arriveTime String
  duration   String
  stops      FlightStops
  price      Int
  date       String
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Hotel {
  id            Int      @id @default(autoincrement())
  name          String
  city          String
  stars         Int
  pricePerNight Int
  imageUrl      String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
